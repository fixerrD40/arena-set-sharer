<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="genesis-users" author="hstafford">
        <comment>Accounts.</comment>
        <createTable tableName="users">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email_hash" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="password_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="genesis-password-resets" author="hstafford">
        <comment>Hashed reset tokens.</comment>
        <createTable tableName="password_resets">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="app_user" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="used" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="password_resets"
                baseColumnNames="app_user"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="password_resets_users_fk"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="user-documents" author="hstafford">
        <comment>Per-user set and deck documents. No card catalog.</comment>
        <createTable tableName="user_documents">
            <column name="user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="VARCHAR(16)">
                <constraints nullable="false"/>
            </column>
            <column name="id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="body" type="JSONB">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="user_documents" columnNames="user_id, type, id" constraintName="user_documents_pk"/>
        <addForeignKeyConstraint
                baseTableName="user_documents"
                baseColumnNames="user_id"
                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="user_documents_users_fk"
                onDelete="CASCADE"/>
    </changeSet>

    <changeSet id="users-admin" author="hstafford">
        <comment>Operator flag for cover upload.</comment>
        <addColumn tableName="users">
            <column name="admin" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
